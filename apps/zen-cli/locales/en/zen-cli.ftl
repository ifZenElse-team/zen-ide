# zen-cli: help texts and errors of the command-line client. English is the source language.

cli-about = Lists and runs Zen Platform commands.
cli-commands-about = Lists every registered command with its id and title.
cli-commands-json = Print the commands as JSON, with descriptions and parameter schemas.
cli-run-about = Runs a command and prints its result as JSON.
cli-run-id = The command id, for example file.project.open.
cli-run-params = The parameters as a JSON object, or - to read them from standard input. Default: { "{}" }.
cli-help = Print help.
cli-version = Print the version.
cli-heading-usage = Usage
cli-heading-commands = Commands
cli-heading-arguments = Arguments
cli-heading-options = Options
cli-value-command = command
cli-value-id = id
cli-value-json = json
cli-usage = zen-cli <command>
cli-commands-usage = zen-cli commands [--json]
cli-run-usage = zen-cli run <id> [--params <json>]
cli-error = zen-cli: { $message }
cli-error-unknown-subcommand = unknown subcommand `{ $name }`; see zen-cli --help
cli-error-unknown-argument = unknown argument `{ $name }`; see zen-cli --help
cli-error-missing-argument = missing { $name }; see zen-cli --help
cli-error-invalid-argument = invalid use of `{ $name }`; see zen-cli --help
cli-error-usage = invalid command line; see zen-cli --help
cli-error-invalid-json = the parameters are not valid JSON: { $error }
cli-error-stdin = cannot read the parameters from standard input: { $error }
cli-error-registry = cannot register the commands: { $error }
cli-error-unknown-command = unknown command `{ $id }`; zen-cli commands lists them
cli-error-unavailable = command `{ $id }` is not available now
cli-error-invalid-params = invalid parameters for `{ $id }`: { $error }
cli-error-failed = `{ $id }` failed: { $error }
cli-error-invalid-output = `{ $id }` produced output that is not JSON: { $error }
cli-ide-about = Starts, lists and stops headless IDEs and calls their tools (ADR-0084).
cli-ide-usage = zen-cli ide <command>
cli-ide-start-about = Starts a headless IDE on a project, or answers the one that already has it open, as JSON.
cli-ide-start-usage = zen-cli ide start <project> [--ide <program>] [--mcp-port <port>]
cli-ide-start-project = The project folder to open.
cli-ide-start-ide = The IDE's program: a path, or a name on PATH or in /Applications. Default: gogarden.
cli-ide-start-port = The MCP server's port. Default: a free one.
cli-ide-list-about = Lists the running headless IDEs: process id, product, MCP URL and projects.
cli-ide-list-usage = zen-cli ide list [--json]
cli-ide-list-json = Print the instances as JSON.
cli-ide-stop-about = Stops a headless IDE as exit_ide does and waits until it has ended.
cli-ide-stop-usage = zen-cli ide stop [--instance <pid|project>]
cli-ide-call-about = Calls a tool of a headless IDE's MCP server and prints its result as JSON.
cli-ide-call-usage = zen-cli ide call <tool> [--args <json>] [--instance <pid|project>]
cli-ide-call-tool = The tool, for example dispatch_command or list_commands.
cli-ide-call-args = The tool's arguments as a JSON object, or - to read them from standard input. Default: { "{}" }.
cli-ide-instance = The instance: its process id, or its project (or a path inside it). Default: the only one running.
cli-value-instance = instance
cli-value-project = project
cli-value-program = program
cli-value-port = port
cli-value-tool = tool
cli-ide-none = no headless IDE is running; start one with zen-cli ide start <project>
cli-ide-several = several headless IDEs are running; name one with --instance (zen-cli ide list)
cli-ide-not-found = no headless IDE matches `{ $target }`; zen-cli ide list lists them
cli-ide-call-failed = the IDE answered an error: { $error }
cli-ide-did-not-stop = the IDE (process { $pid }) did not stop
cli-ide-no-project = cannot open the project { $path }: { $error }
cli-ide-no-program = cannot find the IDE `{ $program }`; give its path with --ide
cli-ide-cannot-start = cannot start { $program }: { $error }
cli-ide-start-timeout = { $program } did not start its MCP server in time
cli-completions-about = Prints the completion script of a shell.
cli-completions-usage = zen-cli completions <shell>
cli-completions-shell = The shell: zsh, bash or fish.
cli-value-shell = shell
cli-complete-required = the required parameters
cli-complete-all = every parameter
