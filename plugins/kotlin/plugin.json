      "preview": "package com.example.shop\n\nimport java.util.UUID\nimport kotlin.math.max\n\ndata class Item(val id: UUID, val price: Int, val free: Boolean = false)\n\nclass Basket(private val limit: Int = 10) : Iterable<Item> {\n    private val items = mutableListOf<Item>()\n\n    fun add(item: Item) {\n        if (items.size >= limit && !item.free) {\n            throw IllegalStateException(\"The basket is full: ${items.size} items\")\n        } else {\n            items += item\n        }\n    }\n\n    fun total(discountPercent: Int): Int {\n        var sum = 0\n        for (index in 0 until items.size) {\n            sum += items[index].price * (100 - discountPercent) / 100\n        }\n        return when (sum) {\n            0 -> 0\n            else -> max(sum, 1)\n        }\n    }\n\n    override fun iterator(): Iterator<Item> = items.iterator()\n}\n",
