      "choices": [
        {
          "id": "context",
          "title": {
            "en": "Context",
            "ru": "Контекст"
          },
          "columns": [
            "name",
            "cluster",
            "user",
            "namespace"
          ],
          "list": {
            "program": "kubectl",
            "args": [
              "config",
              "view",
              "-o",
              "json"
            ]
          },
          "source": {
            "variable": "KUBECONFIG",
            "default": "~/.kube/config"
          }
        },
        {
          "id": "namespace",
          "title": {
            "en": "Namespace",
            "ru": "Пространство имён"
          },
          "columns": [
            "name",
            "status",
            "created"
          ],
          "list": {
            "program": "kubectl",
            "args": [
              "--context",
              "${window.context}",
              "--request-timeout",
              "10s",
              "get",
              "namespaces",
              "-o",
              "json"
            ]
          },
          "initialFrom": "context.namespace"
        }
      ],
