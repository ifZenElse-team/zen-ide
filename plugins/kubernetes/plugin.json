          "columns": [
            "name",
            "ready",
            "status",
            "restarts",
            "node",
            "created"
          ],
          "columnTitles": {
            "name": {
              "en": "Name",
              "ru": "Имя"
            },
            "ready": {
              "en": "Ready",
              "ru": "Готово"
            },
            "status": {
              "en": "Status",
              "ru": "Состояние"
            },
            "restarts": {
              "en": "Restarts",
              "ru": "Перезапуски"
            },
            "node": {
              "en": "Node",
              "ru": "Узел"
            },
            "created": {
              "en": "Created",
              "ru": "Создан"
            }
          },
          "list": {
            "program": "kubectl",
            "args": [
              "--context",
              "${window.context}",
              "--namespace",
              "${window.namespace}",
              "--request-timeout",
              "10s",
              "get",
              "pods",
              "-o",
              "json"
            ]
          },
          "actions": [
            {
              "id": "logs",
              "title": {
                "en": "Show Log",
                "ru": "Показать журнал"
              },
              "kind": "stream",
              "rows": true,
              "program": "kubectl",
              "args": [
                "--context",
                "${window.context}",
                "--namespace",
                "${window.namespace}",
                "logs",
                "--follow",
                "--tail",
                "200",
                "--all-containers",
                "${row.id}"
              ]
            },
            {
              "id": "shell",
              "title": {
                "en": "Open Shell",
                "ru": "Открыть оболочку"
              },
              "kind": "terminal",
              "rows": true,
              "program": "kubectl",
              "args": [
                "--context",
                "${window.context}",
                "--namespace",
                "${window.namespace}",
                "exec",
                "--stdin",
                "--tty",
                "${row.id}",
                "--",
                "sh"
