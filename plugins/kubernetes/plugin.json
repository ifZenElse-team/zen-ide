{
  "name": "Kubernetes",
  "description": "The Kubernetes tool window, through the kubectl you have installed: your kubeconfig's contexts, and the namespaces, pods, deployments, services, config maps, secrets (by name only) and events of the context and namespace you choose in its header; a pod's log and a shell in it, describe, restart a rollout and delete, each change asked in words that name the context. For a manifest file or folder it compares it with the cluster (kubectl diff, shown in the diff viewer) and applies it, which only you start and are asked every time. Its header names the kubeconfig files it reads, as kubectl in your terminal does (KUBECONFIG from your login shell, or ~/.kube/config). It never changes your kubeconfig and downloads nothing.",
  "extensions": [],
  "runs": [
    "kubectl"
  ],
  "personOnly": [
    {
      "program": "kubectl",
      "subcommands": [
        "apply",
        "create",
        "replace",
        "patch",
        "delete",
        "edit",
        "scale",
        "rollout",
        "label",
        "annotate",
        "set",
        "drain",
        "cordon",
        "uncordon",
        "taint"
      ]
    }
  ],
  "targetFiles": [
    "*.yaml",
    "*.yml",
    "*.json"
  ],
  "toolWindows": [
    {
      "id": "kubernetes",
      "title": {
        "en": "Kubernetes",
        "ru": "Kubernetes"
      },
      "icon": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 16 16\"><g fill=\"none\" stroke=\"black\" stroke-width=\"1.2\"><circle cx=\"8\" cy=\"8\" r=\"2.1\"/><circle cx=\"8\" cy=\"2.4\" r=\"1.3\"/><circle cx=\"12.85\" cy=\"5.2\" r=\"1.3\"/><circle cx=\"12.85\" cy=\"10.8\" r=\"1.3\"/><circle cx=\"8\" cy=\"13.6\" r=\"1.3\"/><circle cx=\"3.15\" cy=\"10.8\" r=\"1.3\"/><circle cx=\"3.15\" cy=\"5.2\" r=\"1.3\"/></g></svg>",
