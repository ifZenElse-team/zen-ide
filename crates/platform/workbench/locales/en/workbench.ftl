# Zen Workbench: messages about projects and files. English is the source language.

workbench-error-no-project = No project is open.
workbench-error-no-document = No file is open.
workbench-module-unknown = No module is named or found in { $module }.
workbench-error-tabs-sorted = The tabs are sorted alphabetically, so they cannot be moved: turn off Sort tabs alphabetically in Settings → Editor → General → Editor Tabs.
