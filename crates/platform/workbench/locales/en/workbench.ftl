workbench-read-only-no-file = { $path } is not a file.
workbench-saved = Saved { $file }.
workbench-error-outside-project = { $path } is not a folder of the open project.
workbench-error-separators-outside = { $path } is neither an open file nor a file or folder of the open project.
workbench-error-separators-not-text = { $file } is not a UTF-8 text file: its line separators stay as they are.
workbench-error-separators-read-only = { $file } is read-only: its line separators stay as they are.
workbench-error-separators-link-or-large = { $file } is a link or larger than 16 MB: its line separators stay as they are.
workbench-error-bad-name = “{ $name }” is not a valid name.
