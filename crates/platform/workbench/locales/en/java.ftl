java-coverage-no-classes = No compiled classes were found to measure (target/classes or build/classes).
java-coverage-download-task = Downloading JaCoCo { $version }
java-coverage-download-no-folder = The IDE has no data folder to download JaCoCo into.
java-coverage-download-checksum = The download of { $url } does not match its SHA-512; nothing was installed.
java-coverage-download-unavailable = JaCoCo cannot be downloaded here.
java-coverage-download-done = JaCoCo is installed in { $folder }.
