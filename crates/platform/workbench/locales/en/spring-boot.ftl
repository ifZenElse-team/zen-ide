workbench-spring-boot-kind = Spring Boot
workbench-spring-boot-field-profiles = Active profiles:
workbench-spring-boot-field-overrides = Override configuration properties:
workbench-spring-boot-default = Default:
workbench-spring-boot-deprecated = Deprecated.
workbench-spring-boot-replacement = Use { $replacement } instead.
workbench-spring-boot-declared-by = Declared by { $source }.
workbench-spring-boot-unknown = '{ $name }' is not a known configuration property
workbench-spring-boot-deprecated-key = '{ $name }' is deprecated
workbench-spring-boot-deprecated-use = '{ $name }' is deprecated; the property to use is '{ $replacement }'
workbench-spring-boot-off = The Spring Boot plug-in is not installed or is switched off.
workbench-spring-boot-bean = Spring bean '{ $name }': go to where it is injected
workbench-spring-boot-bean-method = Spring bean '{ $name }' (@Bean): go to where it is injected
workbench-spring-boot-injection = Injected '{ $name }': go to the bean
workbench-spring-boot-no-marker = Line { $line } has no gutter mark.
workbench-spring-boot-no-target = The gutter mark has no target { $index }.
workbench-spring-boot-not-injected = The bean is not injected anywhere in the project.
workbench-spring-boot-no-endpoint = No request mapping of the project is handled by { $handler }.
workbench-spring-boot-group = Spring Boot
workbench-spring-boot-check = Mark Spring Boot versions past their open-source support
workbench-spring-boot-check-description = Reads the support dates of every Spring Boot generation from spring.io once a day and marks the version in pom.xml, build.gradle(.kts) or libs.versions.toml when its open-source support has ended. Off by default.
workbench-spring-boot-support-ended = Spring Boot { $version }: open-source support of { $generation } ended on { $date }
workbench-spring-boot-support-ended-commercial = Spring Boot { $version }: open-source support of { $generation } ended on { $date }; commercial support lasts until { $commercial }
workbench-spring-boot-no-fix = Nothing to fix automatically: change the Spring Boot version in the build file.
workbench-starters-no-build = The project has no Maven or Gradle build.
workbench-starters-no-boot = { $file } does not name a Spring Boot version.
workbench-starters-no-answer = The generator gave no starters.
workbench-starters-unknown = The service has no starter { $starter } for this Spring Boot version.
workbench-starters-not-loaded = The starters are not loaded yet; call springBoot.starters.get first.
workbench-starters-saved = The list comes from a saved answer, because the service could not be asked.
workbench-starters-bad-value = The service gave a value that cannot go into a build file: { $value }
