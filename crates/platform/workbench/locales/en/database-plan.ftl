# Zen Workbench: Explain Plan in the Database workspace.

database-plan-title = Plan: { $name }
database-error-no-plan = There is no Plan tab here: explain a statement first (⌥⌘E).
database-error-no-plan-node = The plan has no node { $node }.
database-error-explain-unsupported = { $name } cannot explain query plans.
database-error-explain-one-statement = Explain one statement at a time: the text holds several.
database-error-explain-analyze-changes = ANALYZE runs the statement, and on this connection its changes could not be undone (MySQL and MariaDB keep changes to tables that are not transactional and commit structure changes at once): explain it without ANALYZE.
