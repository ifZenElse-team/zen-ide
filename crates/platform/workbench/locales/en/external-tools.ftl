workbench-external-tools-no-name = An external tool needs a name.
workbench-external-tools-no-program = The external tool “{ $name }” needs a program.
workbench-external-tools-bad-filter = The output filter “{ $filter }” cannot be used: { $error }
workbench-external-tools-unknown = There is no external tool “{ $id }”.
workbench-external-tools-disabled = The external tool “{ $name }” is switched off in Settings → Tools → External Tools.
workbench-external-tools-copy-name = { $name } (copy)
workbench-external-tools-unreadable = Cannot read the external tools: { $detail }
workbench-external-tools-corrupt = The external tools file is damaged ({ $detail }); it is kept as { $file } and the list starts empty.
workbench-external-tools-save-failed = Cannot save the external tools: { $detail }
workbench-external-tools-no-value = Cannot run “{ $name }”: { $token } has no value ({ $reason }).
workbench-macro-file-path = The absolute path of the current file
workbench-macro-file-dir = The folder of the current file
workbench-macro-file-name = The name of the current file
workbench-macro-file-name-without-extension = The name of the current file without its extension
workbench-macro-project-file-dir = The project's folder
workbench-macro-project-name = The project's name
workbench-macro-selected-text = The text selected in the editor
workbench-macro-line-number = The caret's line number
workbench-macro-column-number = The caret's column number
workbench-macro-prompt = A text asked for when the tool starts
workbench-macro-file-prompt = A file asked for when the tool starts
workbench-macro-clipboard-content = The text on the clipboard
workbench-macro-goroot = The Go SDK's folder (GOROOT)
workbench-macro-gopath = The Go workspace folder (GOPATH)
workbench-macro-go-exec-path = The go program of the Go SDK
workbench-macro-go-file-import-path = The import path of the current file's Go package
workbench-macro-os-name = The operating system's name
workbench-macro-temp-dir = The folder for temporary files
workbench-macro-missing-file = no file is open in the editor
workbench-macro-missing-selection = nothing is selected in the editor
workbench-macro-missing-project = no project is open
workbench-macro-missing-prompt = it is asked for when the tool starts
workbench-macro-missing-clipboard = the clipboard holds no text
workbench-macro-missing-go = no Go SDK is set up
workbench-macro-missing-go-module = the current file is not in a Go module
