# Bookmarks of lines, files and folders: anonymous and mnemonic.

bookmark-no-line = There is no line to act on: give a line or put the caret in the file.
bookmark-bad-mnemonic = “{ $mnemonic }” is not a mnemonic: use a digit 0–9 or a letter A–Z.
bookmark-none = { $path }:{ $line } has no bookmark.
bookmark-line-from-one = Lines count from 1.
bookmark-none-at-all = There are no bookmarks.
bookmark-no-mnemonic = No bookmark has the mnemonic { $mnemonic }.
bookmark-mnemonic-taken = The mnemonic { $mnemonic } is already used by a bookmark at { $path }:{ $line }.
bookmark-list-empty-name = A bookmark list needs a name.
bookmark-list-taken = There is already a bookmark list named “{ $name }”.
bookmark-list-missing = There is no bookmark list named “{ $name }”.
bookmark-list-fallback = Bookmarks
bookmark-none-item = { $path } has no bookmark of its own.
bookmark-mnemonic-taken-item = The mnemonic { $mnemonic } is already used by the bookmark of { $path }.
bookmark-folder = { $path } is a folder: select it in the Project tool window.
bookmark-no-item = { $path } is not a file or folder.
bookmark-no-items = Give the files or folders to bookmark.
