# Zen Workbench: ER diagrams in the Database workspace.

database-diagram-tab-title = { $schema } diagram
database-diagram-cancelled = The diagram's layout was cancelled.
database-diagram-error-no-tab = No ER diagram here: open one with View Diagram, or show the Diagram page of a table or view.
database-diagram-error-path = A diagram is of a schema ([catalog, schema]) or of a table or view ([catalog, schema, folder, name]).
database-diagram-error-not-ready = The diagram is still being laid out.
database-diagram-error-entity = The diagram has no entity named { $name }.
database-diagram-error-renderer = Diagrams can be exported as images only in an IDE window.
database-diagram-error-path-needed = A PNG image is written to a file: give its path.
database-diagram-error-relative = The file's path must be absolute.
database-diagram-error-exists = { $path } exists; pass overwrite to replace it.
