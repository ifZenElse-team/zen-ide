# Zen Platform: the built-in modules' commands. English is the source language (ADR-0024).
modules-error-unknown = There is no built-in plug-in "{ $id }"; plugins.modules.list gives their ids.
modules-error-save = Cannot save { $file }: { $error }
areas-error-none = { $product } has no areas to choose: its bundle marks no plug-ins as optional.
areas-error-unknown = There is no area "{ $id }"; the areas are: { $ids }.
