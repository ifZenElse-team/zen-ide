// A synthetic theme written for the importer's tests.
{
  "$schema": "vscode://schemas/color-theme",
  "name": "Fixture Night",
  "type": "dark",
  "author": "the zen-theme tests",
  "semanticHighlighting": true,
  "colors": {
    /* Editor */
    "editor.background": "#101820",
    "editor.foreground": "#C0C8D0",
    "editorCursor.foreground": "#FFCC00",
    "editor.selectionBackground": "#3060A080",
    "editor.lineHighlightBackground": "#FFFFFF10",
    "editorLineNumber.foreground": "#FFFFFF80",
    "editor.findMatchBackground": "#40804060",
    "editor.findMatchHighlightBackground": "#60A060",
    "editor.wordHighlightBackground": "#FFFFFF20",
    "editor.wordHighlightStrongBackground": "#FF404030",
    "editorBracketMatch.background": "#0064001A",
    "editorError.foreground": "#FF4050",
    "editorWarning.foreground": "#E0B040",
    "editorInfo.foreground": "#4090E0",
    // Window
    "sideBar.background": "#0C1218",
    "titleBar.activeBackground": "#000000",
    "statusBar.background": "blue",
    "panel.background": "#141C24",
    "list.hoverBackground": "#FFFFFF0A",
    "list.activeSelectionBackground": "#2050A0",
    "editorWidget.background": "#182028",
    "editorWidget.border": "#304050",
    "input.background": "#0A0E12",
    "input.border": "#405060",
    "button.background": "#2A7AE0",
    "button.foreground": "#FFF",
    "button.border": "#506070",
    "tab.border": "#202830",
    "tab.activeBackground": "#1A2430",
    "tab.activeBorderTop": "#2A7AE0",
    "textLink.foreground": "#5AB0FF",
    "errorForeground": "#FF6060",
    "activityBar.background": "#000000",
    "editor.hoverHighlightBackground": null,
    // Terminal
    "terminal.background": "#0E141A",
    "terminal.foreground": "#D0D8E0",
    "terminalCursor.foreground": "#FFCC0080",
    "terminal.ansiBlack": "#000000",
    "terminal.ansiRed": "#CC0000",
    "terminal.ansiGreen": "#00CC00",
    "terminal.ansiYellow": "#CCCC00",
    "terminal.ansiBlue": "#0000CC",
    "terminal.ansiMagenta": "#CC00CC",
    "terminal.ansiCyan": "#00CCCC",
    "terminal.ansiWhite": "#CCCCCC",
    "terminal.ansiBrightBlack": "#666666",
    "terminal.ansiBrightRed": "#FF3333",
    "terminal.ansiBrightGreen": "#33FF33",
    "terminal.ansiBrightYellow": "#FFFF33",
    "terminal.ansiBrightBlue": "#3333FF",
    "terminal.ansiBrightMagenta": "#FF33FF",
    "terminal.ansiBrightCyan": "#33FFFF",
    "terminal.ansiBrightWhite": "#FFFFFF",
  },
  "tokenColors": [
    { "settings": { "foreground": "#AABBCC", "background": "#000000", "caret": "#123456", "fontFamily": "Mono" } },
    { "name": "Comments", "scope": "comment", "settings": { "foreground": "#607080", "fontStyle": "italic" } },
    { "scope": "comment.block.documentation", "settings": { "foreground": "#70A080" } },
    { "scope": "keyword, storage.type", "settings": { "foreground": "#E08050", "fontStyle": "bold" } },
    { "scope": ["string", "constant.numeric"], "settings": { "foreground": "#80C080" } },
    { "scope": "constant.numeric", "settings": { "foreground": "#40C0D0" } },
    { "scope": "entity.name.function", "settings": { "foreground": "#60A8F0" } },
    { "scope": "meta.function-call entity.name.function", "settings": { "foreground": "#B0A080" } },
    { "scope": "entity.name.type", "settings": { "foreground": "#70B0C0", "fontStyle": "underline" } },
    { "scope": "markup.heading", "settings": { "foreground": "#D080C0", "fontStyle": "bold underline" } },
    { "scope": "markup.italic", "settings": { "fontStyle": "italic" } },
    { "scope": "markup.bold", "settings": { "foreground": "#E0E0E0", "fontStyle": "bold strikethrough" } },
    { "scope": "entity.name.namespace", "settings": { "foreground": "#A0B070" } },
    { "scope": "punctuation", "settings": { "foreground": "#90989F80" } },
    { "scope": "source.go, (a | b)", "settings": { "foreground": "#FF0000" } },
    { "scope": "invalid.illegal", "settings": { "foreground": "#FF0000", "background": "#400000" } },
    { "name": "No settings", "scope": "string" },
  ],
  "semanticTokenColors": {
    "namespace": "#C0D080",
    "type": { "foreground": "#80C0E0", "italic": true },
    "function.declaration": { "bold": true },
    "method": "#E0C090",
    "variable.readonly:go": "#FF00FF",
    "*.deprecated": { "strikethrough": true },
    "keyword": "not a colour",
  },
}
