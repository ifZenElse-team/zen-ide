// A synthetic light theme, written for the tests: a white editor, a light grey side bar, faint
// secondary text that must be made readable, and colours with alpha.
{
  "name": "Fixture Day",
  "type": "light",
  "colors": {
    "editor.background": "#FFF8", // half transparent white over white
    "editor.foreground": "#222D",
    "editorCursor.foreground": "#1A1A1A",
    "editor.selectionBackground": "#ADD6FF",
    "editor.lineHighlightBackground": "#0000000A",
    "editorLineNumber.foreground": "#9A9A9A",
    "editor.findMatchBackground": "#F8E08A",
    "editor.wordHighlightBackground": "#57575740",
    "editorGutter.addedBackground": "#48A860",
    "editorGutter.modifiedBackground": "#3E7BD6",
    "editorGutter.deletedBackground": "#D05050",
    "diffEditor.insertedLineBackground": "#9BE5A040",
    "diffEditor.removedLineBackground": "#FF9A9A40",
    "diffEditor.insertedTextBackground": "#9BE5A080",
    "diffEditor.removedTextBackground": "#FF9A9A80",
    "diffEditor.diagonalFill": "#00000010",
    "sideBar.background": "#F3F3F3",
    "panel.background": "#FFFFFF",
    "foreground": "#333333",
    "descriptionForeground": "#C0C0C0", // too faint on white: made readable on import
    "errorForeground": "#C42B1C",
    "textLink.foreground": "#0066BF",
    "button.background": "#0F6CBD",
    "button.foreground": "#FFFFFF",
    "list.hoverBackground": "#0001",
    "list.activeSelectionBackground": "#CCE4F7",
    "menu.background": "#FFFFFF",
    "menu.border": "#D0D0D0",
    "input.background": "#FFFFFF",
    "input.border": "#CECECE",
    "tab.activeBackground": "#FFFFFF",
    "tab.border": "#E5E5E5",
    "gitDecoration.modifiedResourceForeground": "#895503",
    "gitDecoration.addedResourceForeground": "#587C0C",
    "gitDecoration.untrackedResourceForeground": "#007100",
    "gitDecoration.ignoredResourceForeground": "#8E8E90",
    "gitDecoration.conflictingResourceForeground": "#AD0707",
    "terminal.background": "#FFFFFF",
    "terminal.foreground": "#333333",
    "terminal.ansiYellow": "#E5E500", // unreadable on white: made readable on import
    "terminal.ansiBlue": "#0451A5",
  },
  "tokenColors": [
    { "scope": "string", "settings": { "foreground": "#0A0" } },
    { "scope": ["keyword", "storage.type"], "settings": { "foreground": "#0000FF" } },
    { "scope": "comment", "settings": { "foreground": "#008000", "fontStyle": "italic" } },
    { "scope": "entity.name.function", "settings": { "foreground": "#795E26" } },
    { "scope": "constant.numeric", "settings": { "foreground": "#098658" } },
  ],
}
