# Local History's windows (zen_ui::ide::local_history, ADR-0060). English is the source language.

ide-local-history-title = History of { $name }
ide-local-history-empty = No local history yet
ide-local-history-no-changes = No files changed since this version
ide-local-history-no-diff = Nothing to compare
ide-local-history-revert = Revert
ide-local-history-close = Close
ide-local-history-reverted = { $count ->
    [0] Nothing to revert: the files are as they were
    [one] 1 file reverted
   *[other] { $count } files reverted
}
ide-local-history-modified = modified
ide-local-history-deleted = deleted
ide-local-history-added = created since
ide-local-history-today = Today { $time }
ide-local-history-yesterday = Yesterday { $time }
ide-local-history-label-title = Put Label
ide-local-history-label-name = Label name:
ide-local-history-label-ok = OK
ide-local-history-label-cancel = Cancel
