# Zen UI: имена, которые читают программы экранного доступа для элементов без видимого текста.

a11y-close-tab = Закрыть { $name }
a11y-pinned = Закреплена
a11y-unpin-tab = Открепить { $name }
a11y-workspace = Рабочая область «{ $title }»
a11y-hide = Скрыть
a11y-options = Параметры
a11y-terminal-tabs = Вкладки терминала
a11y-modified = изменён
a11y-problem = { $severity ->
    [error] Ошибка
    [warning] Предупреждение
    [information] Сведения
    [typo] Опечатка
   *[other] Подсказка
}: { $message }, строка { $line }
a11y-editor = Редактор: { $file }
a11y-editor-split = Редактор: { $file }, группа { $split } из { $count }
a11y-editor-divider = Разделитель групп редакторов
a11y-gutter = Поле слева
a11y-run-icon = Запустить { $name }
a11y-fold = Сворачиваемый блок на строке { $line }
a11y-tests = Тесты
a11y-console = Консоль
a11y-sticky-lines = Закреплённые строки
a11y-change = { $kind ->
    [added] Добавленные строки
    [deleted] Удалённые строки
   *[other] Изменённые строки
}
a11y-threads = Потоки
a11y-navigation-bar = Панель навигации
