# Go module: Settings → Languages & Frameworks → Go, Editor → Code Style → Go, and the offer to
# install Delve. English is the source language (ADR-0024).
settings-go = Go
settings-go-modules = Go Modules
settings-go-env = Environment
settings-go-env-shared = Shared with the project (.zen/go.json):
settings-go-env-shared-note = Kept in the project and given to everyone who has it; never put a password or token here.
settings-go-env-untrusted = The project is not trusted: the environment of .zen/go.json is left out until you trust it.
settings-go-env-personal = Only on this computer:
settings-go-env-note = Variables such as GOPROXY=https://proxy.example; GOPRIVATE=*.corp.example, separated by ";". They reach every go command the IDE runs for the project and gopls; yours win over the shared ones, and a run configuration's environment wins over both.
settings-go-env-effective = In effect
settings-go-env-none = Nothing: go commands get the IDE's environment and your login shell's.
settings-go-env-from-project = from the project
settings-go-env-from-personal = from this computer
settings-go-env-checks = The IDE's own checks (go.mod, go vet) still run with GOTOOLCHAIN=local and GOPROXY=off, and add -mod=readonly to GOFLAGS.
settings-go-goroot = GOROOT
settings-go-add-sdk = Add SDK
settings-go-add-local = Local…
settings-go-pick-sdk = Choose the Go SDK folder
settings-go-remove-sdk = Remove
settings-go-sdk-gone = The Go SDK chosen is gone: { $root } (an upgrade may have removed it).
settings-go-sdk-use = Use { $sdk }
settings-go-gopls-missing = Not installed
settings-go-gopls-path = Custom path:
settings-go-gopls-path-note = Leave it empty to use the gopls found in GOBIN, GOPATH/bin or on PATH.
settings-go-gopls-update = Update gopls
settings-go-refresh = Look again
settings-go-note = gopls is the Go language server: completion, navigation and errors come from it. It is installed with go install into GOPATH/bin.
settings-go-delve = Delve
settings-go-dlv-missing = Not found
settings-go-dlv-outdated = This Delve is too old: debugging needs Delve { $minimum } or newer. Update it.
settings-go-dlv-installing = Installing Delve… { $detail }
settings-go-dlv-failed = Delve could not be installed: { $detail }
settings-go-dlv-path = Custom path:
settings-go-dlv-path-note = Leave it empty to use the dlv found in GOBIN, GOPATH/bin or on PATH.
settings-go-dlv-install = Install Delve
settings-go-dlv-update = Update Delve
settings-go-dlv-note = Delve (dlv) is the Go debugger. Install Delve or Update Delve downloads it from the internet with go install github.com/go-delve/delve/cmd/dlv@latest into GOPATH/bin, only when you click it.
settings-go-on-save = On Save
settings-go-reformat-on-save = Reformat code on save
settings-go-optimize-imports-on-save = Optimize imports on save
settings-go-configure-on-save = Configure on Actions on Save
ide-gopls-install = Install gopls
ide-gopls-installing = Installing gopls… { $detail }
ide-gopls-failed = gopls could not be installed: { $detail }
ide-go-sdk-missing = No Go SDK is found on this computer.
ide-go-download = Download Go
settings-section-code-style-go = Go
ide-debugger-missing-title = Delve is not installed
ide-debugger-missing-detail = Go code is debugged with Delve. Installing it downloads Delve with go install.
ide-debugger-install = Install Delve
ide-debugger-installing = Installing Delve with go install…
module-go-name = Go
module-go-description = Everything for Go: highlighting, Go modules and the Structure, gopls (completion, navigation, problems), run, test and debug with Delve, go.mod updates and vulnerabilities, the Go SDK and its settings, live templates.
settings-go-folding = Go
settings-go-fold-if-errors = One-line 'if' blocks for error handling
settings-go-fold-one-line-returns = One-line functions with a single 'return'
settings-go-fold-one-line-cases = One-line case clauses
settings-go-fold-empty-functions = Empty functions
settings-go-fold-empty-types = Empty struct or interface type definitions
settings-go-fold-formatted-strings = Formatted strings
go-code-style-formatter = Formatter
go-code-style-gofumpt = Format with gofumpt's stricter rules
go-code-style-align-struct-tags = Line up the values of struct tags
go-code-style-import-groups = Import groups
go-code-style-local = Put imports that begin with this prefix after third-party imports:
go-code-style-note-tabs = gofmt always indents Go with tab characters and aligns with spaces; the tab size only sets how wide a tab is drawn.
go-code-style-note-spaces = gofmt decides every space in Go code and has no options for them.
go-code-style-note-wrapping = gofmt never wraps lines and keeps opening braces on the line of their statement; it has no options for them. gopls can format with gofumpt instead, which is stricter.
go-code-style-note-blank-lines = gofmt keeps at most one blank line in a row and has no options for blank lines.
go-code-style-note-imports = Optimize Imports sorts the imports in goimports order: the standard library first, then the other imports; gopls passes the prefix below on as its local setting.
go-code-style-note-arrangement = Rearrange Code puts top-level declarations in this order and keeps the order of declarations of the same kind, so variables are initialised and init functions run as before.
go-code-style-arrange-const = Constants
go-code-style-arrange-var = Variables
go-code-style-arrange-type = Types
go-code-style-arrange-func = Functions and methods
settings-go-staticcheck = staticcheck
settings-go-staticcheck-missing = Not found
settings-go-staticcheck-install = Install staticcheck
settings-go-staticcheck-update = Update staticcheck
settings-go-staticcheck-installing = Installing staticcheck… { $detail }
settings-go-staticcheck-failed = staticcheck could not be installed: { $detail }
settings-go-staticcheck-note = staticcheck finds bugs and style problems in Go code. Install staticcheck or Update staticcheck downloads it from the internet with go install honnef.co/go/tools/cmd/staticcheck@latest into GOPATH/bin, only when you click it.
go-inspections-group = Inspections
go-inspections-vet = Check with go vet
go-inspections-vet-description = Runs go vet on the package of an open Go file. Its problems join gopls's in the editor and in Problems.
go-inspections-staticcheck = Check with staticcheck
go-inspections-staticcheck-description = Runs staticcheck on the package of an open Go file, when it is installed.
go-inspections-on-save = Check when a file is saved
go-inspections-on-save-description = Turned off, they run only with Run go vet and staticcheck.
go-inspections-fix-stale = The file changed after it was checked. Save it and wait for the check, then try again.
