{
  "language": "rust",
  "title": "settings-section-code-style-rust",
  "preview": "use std::collections::HashMap;\nuse std::fmt;\n\npub struct Point {\n    pub x: i32,\n    pub y: i32,\n}\n\nimpl fmt::Display for Point {\n    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {\n        write!(f, \"({}, {})\", self.x, self.y)\n    }\n}\n\nfn count(words: &[&str]) -> HashMap<String, usize> {\n    let mut counts = HashMap::new();\n    for word in words {\n        *counts.entry(word.to_string()).or_insert(0) += 1;\n    }\n    counts\n}\n\nfn main() {\n    let point = Point { x: 1, y: 2 };\n    match point.x {\n        0 => println!(\"origin {point}\"),\n        _ => println!(\"{:?}\", count(&[\"a\", \"b\", \"a\"])),\n    }\n}\n",
  "options": [
    {
      "id": "hard_tabs",
      "label": "rust-code-style-hard-tabs",
      "group": "rust-code-style-rustfmt",
      "tab": "tabsAndIndents",
      "kind": {
        "type": "boolean"
      },
      "default": false,
      "configKey": "hard_tabs"
    },
    {
      "id": "tab_spaces",
      "label": "rust-code-style-tab-spaces",
      "group": "rust-code-style-rustfmt",
      "tab": "tabsAndIndents",
      "kind": {
        "type": "integer",
        "min": 1,
        "max": 32
      },
      "default": 4,
      "configKey": "tab_spaces"
    },
    {
      "id": "max_width",
      "label": "rust-code-style-max-width",
      "group": "rust-code-style-rustfmt",
      "tab": "wrappingAndBraces",
      "kind": {
        "type": "integer",
        "min": 1,
        "max": 1000
      },
      "default": 100,
      "configKey": "max_width",
      "editorConfig": "max_line_length"
    },
    {
      "id": "use_small_heuristics",
      "label": "rust-code-style-use-small-heuristics",
      "group": "rust-code-style-rustfmt",
